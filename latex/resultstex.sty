% resultstex.sty -- \result{key} prints a value generated by code.
% Usage in paper.tex (after \usepackage{resultstex}):
%   \input{results}   % results.tex from `python -m resultstex build`
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resultstex}[2026/09/29 results from code]
\RequirePackage{xcolor}
\newcommand{\resultdef}[2]{\expandafter\gdef\csname resultval@#1\endcsname{#2}}
\newcommand{\result}[1]{%
  \ifcsname resultval@#1\endcsname
    \csname resultval@#1\endcsname
  \else
    \textbf{\textcolor{red}{??\detokenize{#1}??}}%
    \PackageWarning{resultstex}{Result key undefined: #1}%
  \fi}
\endinput
